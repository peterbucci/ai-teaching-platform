{
  "name": "ai-teaching-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "content:check": "python content/network-performance-v1/verify_package.py",
    "test": "node --experimental-strip-types --conditions=react-server --test tests/*.test.ts",
    "db:migrate": "node --experimental-strip-types --conditions=react-server --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "node --experimental-strip-types --conditions=react-server --env-file-if-exists=.env scripts/seed-demo.ts",
    "objectives:check": "node --experimental-strip-types --conditions=react-server --env-file-if-exists=.env scripts/check-objectives.ts",
    "materials:check": "node --experimental-strip-types --conditions=react-server --env-file-if-exists=.env scripts/check-materials.ts",
    "lessons:uncertainty:check": "node --experimental-strip-types --conditions=react-server --env-file-if-exists=.env scripts/check-lesson-uncertainty.ts",
    "lessons:check": "node --experimental-strip-types --conditions=react-server --env-file-if-exists=.env scripts/check-lessons.ts",
    "questions:check": "node --experimental-strip-types --conditions=react-server --env-file-if-exists=.env scripts/check-question-bank.ts",
    "questions:live": "node --experimental-strip-types --conditions=react-server --env-file-if-exists=.env scripts/check-question-bank-live.ts",
    "assignments:check": "node --experimental-strip-types --conditions=react-server --env-file-if-exists=.env scripts/check-assignments.ts",
    "reading:check": "node --experimental-strip-types --conditions=react-server --env-file-if-exists=.env scripts/check-reading.ts",
    "metrics:check": "node --experimental-strip-types --conditions=react-server --env-file-if-exists=.env scripts/check-metrics.ts",
    "patterns:check": "node --experimental-strip-types --conditions=react-server --env-file-if-exists=.env scripts/check-patterns.ts",
    "class:check": "node --experimental-strip-types --conditions=react-server --env-file-if-exists=.env scripts/check-class-fixture.ts",
    "db:check": "node --experimental-strip-types --conditions=react-server --env-file-if-exists=.env scripts/check-persistence.ts",
    "eval:live": "node --experimental-strip-types --conditions=react-server --env-file-if-exists=.env scripts/check-evaluation.ts",
    "tutor:check": "node --experimental-strip-types --conditions=react-server --env-file-if-exists=.env scripts/check-tutoring.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "better-auth": "^1.7.9",
    "lucide-react": "^1.61.0",
    "next": "16.4.0",
    "openai": "^7.34.0",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
