              "sequence_id": "transmission_propagation_demo_v1",
              "prompt_text": "A single cable becomes twice as long. Packet size, link transmission rate, and propagation speed stay unchanged. What happens to transmission delay and propagation delay? Explain why.",
              "content_ref": {
                "package_id": "network-performance-v1",
                "content_version": "3bd292c1476f5becb658418b70ee36153cfce830",
                "source_id": "peterson_davie_1_5_1",
