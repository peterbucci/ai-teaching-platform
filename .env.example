# Copy to ignored .env. Set independent random secrets before starting Compose.
# Compose uses the internal db hostname; these values also support local Next.js.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=learning_platform
# Bootstrap administrator and application passwords must be different.
POSTGRES_PASSWORD=
PGPASSWORD=

# AUTH_URL is the browser-visible origin. Use HTTPS on a deployed server.
AUTH_URL=http://localhost:3000
AUTH_SECRET=

# Only the explicit db:seed command creates these fictional accounts.
# Use distinct emails and passwords of at least 12 characters. No public signup.
DEMO_TEACHER_EMAIL=
DEMO_TEACHER_PASSWORD=
DEMO_STUDENT_ONE_EMAIL=
DEMO_STUDENT_ONE_PASSWORD=
DEMO_STUDENT_TWO_EMAIL=
DEMO_STUDENT_TWO_PASSWORD=

# Reserved for the later OpenAI evaluator; not needed for this persistence demo.
OPENAI_API_KEY=
OPENAI_MODEL=
