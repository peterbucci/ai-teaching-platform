# The application shell runs without environment variables.
# Future integrations: copy this file to .env.local and replace placeholders.
# Keep OpenAI and Supabase secret keys server-side.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=your-approved-model
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Optional: link already-provisioned Supabase Auth users to the fictional seed.
# Create the accounts in your development project; these are Auth user UUIDs.
DEMO_TEACHER_AUTH_ID=
DEMO_STUDENT_ONE_AUTH_ID=
DEMO_STUDENT_TWO_AUTH_ID=

# Only used by the opt-in real Supabase persistence check. Never commit values.
DEMO_TEACHER_EMAIL=
DEMO_TEACHER_PASSWORD=
DEMO_STUDENT_ONE_EMAIL=
DEMO_STUDENT_ONE_PASSWORD=
DEMO_STUDENT_TWO_EMAIL=
DEMO_STUDENT_TWO_PASSWORD=
